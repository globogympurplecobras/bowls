rules_version = '2';

// Only relevant once you've filled in FIREBASE_CONFIG in index.html and
// turned on Firestore in the Firebase console. Not used at all while the
// app is running in local-device-only mode.
//
// To activate: Firebase console -> Firestore Database -> enable it, then
// add a "firestore" block to firebase.json pointing at this file, e.g.:
//   "firestore": { "rules": "firestore.rules" }
// and run: npx firebase-tools deploy --only firestore:rules

service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
